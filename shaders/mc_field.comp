#version 450
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

#include "mc_common.glsl"

layout(set = 0, binding = 1) writeonly buffer FieldBuf {
    float field[];
};

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID);
    int n = pc.grid + 1;
    if (any(greaterThanEqual(id, ivec3(n)))) return;

    vec3 local = (vec3(id) - 0.5 * float(pc.grid)) * pc.originCell.w;
    field[(id.z * n + id.y) * n + id.x] = evalField(local, pc.time);
}
